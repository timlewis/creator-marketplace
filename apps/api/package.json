{
  "name": "@marketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "predev": "pnpm --filter @marketplace/core --filter @marketplace/db build"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@marketplace/core": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "zod": "^4.1.12",
    "@marketplace/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js"
}
